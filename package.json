{
  "name": "ai-detour-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:baseline": "npm run build && node --test dist/tests/baseline.test.js",
    "test:acceptance": "npm run build && node --test dist/tests/acceptance.test.js",
    "triage": "node dist/src/cli.js",
    "lab:prepare": "node labs/01-overdue/prepare.mjs",
    "lab:search": "node labs/02-ticket-search/prepare.mjs",
    "agent:status": "codex login status",
    "agent:login": "codex login",
    "agent:version": "codex --version",
    "agent:run": "node agent/run-task.ts",
    "agent:verify": "node agent/verify-search.ts",
    "agent:check": "tsc -p agent/tsconfig.json",
    "agent:test": "node --test agent/process.test.ts",
    "loop": "node workflow/cli.ts",
    "loop:check": "tsc -p workflow/tsconfig.json",
    "loop:test": "node --test workflow/engine.test.ts",
    "mcp:serve": "node workflow/mcp-server.ts",
    "model:start": "node workflow/model-runtime.mjs start",
    "model:status": "node workflow/model-runtime.mjs status",
    "model:stop": "node workflow/model-runtime.mjs stop",
    "model:resume": "node workflow/model-runtime.mjs resume",
    "model:config:test": "node --test workflow/runtime-options.test.mjs",
    "evaluate": "node operations/evaluation.ts",
    "ops:check": "tsc -p operations/tsconfig.json",
    "graph": "node operations/graph.ts",
    "worker": "node operations/worker.ts",
    "ops:test": "node --test operations/operations.test.ts operations/graph.test.ts",
    "permissions": "node operations/permissions.ts",
    "verify:candidates": "node operations/verification.ts",
    "controls:up": "docker compose -p ai-detour-controls -f operations/compose.yaml up -d --wait",
    "controls:stop": "docker compose -p ai-detour-controls -f operations/compose.yaml stop",
    "events": "node operations/events.ts",
    "model:variant": "node operations/model-runtime.mjs",
    "team": "node operations/team.ts",
    "lab:capstone": "node labs/03-queue-overview/prepare.mjs",
    "capstone:verify": "node agent/verify-capstone.ts",
    "graph:decision": "node operations/decision.ts",
    "capstone:serve": "node agent/serve-capstone.mjs",
    "practice:check": "tsc -p practice/tsconfig.json",
    "practice:test": "node --test practice/*.test.ts",
    "pipeline": "node practice/pipeline.ts",
    "pipeline:permit": "node practice/execution-permit.ts",
    "pipeline:review": "node practice/review.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint-mongodb": "1.5.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "mongodb": "6.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@openai/codex": "0.171.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
